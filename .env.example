# 複製成 .env 後填入；.env 不會進 git
# FinMind（https://finmindtrade.com 免費註冊 → 使用者資訊取得 token）
FINMIND_TOKEN=

# LINE Messaging API（LINE Developers → 建立 Messaging API channel）
# Channel access token（long-lived）
LINE_CHANNEL_ACCESS_TOKEN=
# Basic settings 頁面的「Your user ID」（U 開頭），推播給自己
LINE_USER_ID=
# LINE 訊息裡附上的網站連結
PUBLIC_BASE_URL=http://localhost:8000

# 預設風控（也可在網站「設定」頁修改）
CAPITAL=1000000
PER_TRADE_CAPITAL=100000
MAX_LOSS_PER_TRADE=10000
FEE_DISCOUNT=0.3

# 選股母體
MIN_AVG_VOLUME=1000
MIN_PRICE=10

# 盤中監控頻率（秒，最低 20）
MONITOR_INTERVAL_SEC=60
BACKFILL_DAYS=400
